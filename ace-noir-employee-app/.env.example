# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Ace Noir Employee Portal

# Company Configuration (for white-labeling)
NEXT_PUBLIC_COMPANY_NAME=Ace Noir Cleaning Services
NEXT_PUBLIC_COMPANY_EMAIL=info@acenoirclean.com
NEXT_PUBLIC_COMPANY_PHONE=626-788-2108

# ========================================
# Lead Generation Workflow Configuration
# ========================================

# Appify Google Scraper
APPIFY_API_KEY=your_appify_api_key
APPIFY_ENDPOINT_URL=https://api.appify.com/v1/google-places
APPIFY_RATE_LIMIT=30

# Google Sheets Integration
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEETS_RAW_SHEET=Leads_Raw
GOOGLE_SHEETS_QUALIFIED_SHEET=Leads_Qualified

# Email Configuration (uses RESEND_API_KEY above)
EMAIL_FROM_ADDRESS=outreach@yourdomain.com
EMAIL_FROM_NAME=Your Company
EMAIL_REPLY_TO=reply@yourdomain.com

# Enrichment Providers (optional)
HUNTER_API_KEY=your_hunter_api_key
APOLLO_API_KEY=your_apollo_api_key

# Workflow Settings
LEAD_WORKFLOW_DAILY_EMAIL_LIMIT=50
LEAD_WORKFLOW_MIN_EMAIL_CONFIDENCE=0.70
ENRICHMENT_CACHE_TTL_HOURS=24
ENRICHMENT_MAX_PAGES=3
ENRICHMENT_CRAWL_DELAY_MS=1000

# Development/Testing
USE_MOCK_SERVICES=false
USE_MOCK_APPIFY=false
USE_MOCK_SHEETS=false
USE_MOCK_ENRICHMENT=false
USE_MOCK_EMAIL=false
