          "values": [
            {
              "key": "pageTitle",
              "cssSelector": "title"
            },
            {
              "key": "metaDescription",
              "cssSelector": "meta[name='description']",
              "attribute": "content"
            },
            {
              "key": "h1Text",
              "cssSelector": "h1"
            },
            {
              "key": "bodyText",
              "cssSelector": "body",
              "returnValue": "text"
            }
          ]
        },
        "options": {}
