{
  "name": "Google Maps Lead Generation - Full Pipeline",
  "nodes": [
    {
      "parameters": {
        "formTitle": "🗺️ Google Maps Lead Generator",
        "formDescription": "Enter your search criteria to scrape and enrich business leads from Google Maps. Includes email finding and AI-powered personalization.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Business Type / Industry",
              "placeholder": "e.g., plumbers, HVAC contractors, dentists, real estate agents",
              "requiredField": true
            },
            {
              "fieldLabel": "City",
              "placeholder": "e.g., Austin, San Francisco, Miami",
              "requiredField": true
            },
            {
              "fieldLabel": "State",
              "placeholder": "e.g., TX, CA, FL",
              "requiredField": true
            },
            {
              "fieldLabel": "Zipcode (Optional)",
              "placeholder": "e.g., 78701 - for more precise targeting",
              "requiredField": false
            },
            {
              "fieldLabel": "Search Radius",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {"option": "5 miles"},
                  {"option": "10 miles"},
                  {"option": "25 miles"},
                  {"option": "50 miles"}
                ]
              },
              "requiredField": false
            },
            {
              "fieldLabel": "Maximum Leads",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {"option": "25"},
                  {"option": "50"},
                  {"option": "100"},
                  {"option": "200"},
                  {"option": "500"}
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Minimum Rating",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {"option": "Any"},
                  {"option": "3.0+"},
                  {"option": "3.5+"},
                  {"option": "4.0+"},
                  {"option": "4.5+"}
                ]
              },
              "requiredField": false
            },
            {
              "fieldLabel": "Find Emails?",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {"option": "Yes - Find emails (slower)"},
                  {"option": "No - Just basic info (faster)"}
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "✅ Lead generation started!\n\nYour request is being processed. The scraper will:\n1. Search Google Maps for matching businesses\n2. Filter by your criteria\n3. Enrich with contact information\n4. Save results to Google Sheets\n\nCheck your Google Sheet for results in a few minutes."
            }
          }
        }
      },
      "id": "form-trigger",
      "name": "Lead Search Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.1,
      "position": [-200, 300],
      "webhookId": "gmap-lead-gen-full"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "query",
              "name": "searchQuery",
              "value": "={{ $json['Business Type / Industry'] }} in {{ $json['City'] }}, {{ $json['State'] }}{{ $json['Zipcode (Optional)'] ? ' ' + $json['Zipcode (Optional)'] : '' }}",
              "type": "string"
            },
            {
              "id": "max",
              "name": "maxResults",
              "value": "={{ parseInt($json['Maximum Leads']) || 50 }}",
              "type": "number"
            },
            {
              "id": "min-rating",
              "name": "minRating",
              "value": "={{ $json['Minimum Rating'] === 'Any' ? 0 : parseFloat($json['Minimum Rating'].replace('+', '')) || 0 }}",
              "type": "number"
            },
            {
              "id": "find-emails",
              "name": "findEmails",
              "value": "={{ $json['Find Emails?'].includes('Yes') }}",
              "type": "boolean"
            },
            {
              "id": "timestamp",
              "name": "scrapeTimestamp",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-params",
      "name": "Prepare Parameters",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [20, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/compass~crawler-google-places/run-sync-get-dataset-items",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"searchStringsArray\": [\"{{ $json.searchQuery }}\"],\n  \"maxCrawledPlacesPerSearch\": {{ $json.maxResults }},\n  \"language\": \"en\",\n  \"maxImages\": 0,\n  \"maxReviews\": 0,\n  \"placeMinimumStars\": {{ $json.minRating }},\n  \"onlyDataFromSearchPage\": false,\n  \"scrapeDirectories\": false,\n  \"skipClosedPlaces\": true,\n  \"scrapeReviewsPersonalData\": false\n}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 600000
        }
      },
      "id": "apify-scrape",
      "name": "Scrape Google Maps",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 300],
      "credentials": {
        "httpQueryAuth": {
          "id": "YOUR_APIFY_CREDENTIAL_ID",
          "name": "Apify API Token"
        }
      },
      "notes": "Apify Google Maps Scraper - compass/crawler-google-places"
    },
