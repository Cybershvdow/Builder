    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an expert at analyzing business websites and crafting personalized outreach. Based on the following information about a business, create a brief, personalized icebreaker that could be used in a cold email or call.\n\nBusiness Name: {{ $('Loop Over Items').item.json.businessName }}\nCategory: {{ $('Loop Over Items').item.json.category }}\nWebsite Title: {{ $json.pageTitle }}\nMeta Description: {{ $json.metaDescription }}\nMain Heading: {{ $json.h1Text }}\n\nCreate a 1-2 sentence personalized icebreaker that:\n- References something specific about their business\n- Shows you've done research\n- Is professional but friendly\n- Does NOT include any sales pitch\n\nRespond with ONLY the icebreaker text, nothing else."
            }
          ]
        },
        "options": {
          "maxTokens": 150,
          "temperature": 0.7
        }
      },
      "id": "icebreaker",
      "name": "Generate Icebreaker",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [2440, 200],
      "credentials": {
        "openAiApi": {
          "id": "YOUR_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      },
      "notes": "AI generates personalized outreach icebreaker"
    },
