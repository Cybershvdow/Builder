{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acenoir.com/schemas/webhook-payload.json",
  "title": "InboundCallWebhookPayload",
  "description": "Webhook payload from voice platform for inbound calls to Ace Noir Cleaning Services",
  "type": "object",
  "required": ["call_id", "event_type", "timestamp"],
  "properties": {
    "call_id": {
      "type": "string",
      "description": "Unique identifier for the call session (used for idempotency)",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 8,
      "maxLength": 64
    },
    "event_type": {
      "type": "string",
      "enum": ["call_start", "transcript_update", "call_end"],
      "description": "Type of call event"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the event"
    },
    "caller_phone": {
      "type": "string",
      "description": "Caller's phone number in E.164 format",
      "pattern": "^\\+?[1-9]\\d{1,14}$"
    },
    "called_phone": {
      "type": "string",
      "description": "Ace Noir's receiving phone number",
      "pattern": "^\\+?[1-9]\\d{1,14}$"
    },
    "call_direction": {
      "type": "string",
      "enum": ["inbound", "outbound"],
      "default": "inbound"
    },
    "call_status": {
      "type": "string",
      "enum": ["ringing", "in_progress", "completed", "failed", "no_answer", "busy"],
      "description": "Current status of the call"
    },
    "call_duration_seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "Duration of call in seconds (available at call_end)"
    },
    "transcript": {
      "type": "object",
      "description": "Transcript data (structure varies by mode)",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["single_shot", "streamed"],
          "description": "single_shot = full transcript at end, streamed = incremental updates"
        },
        "full_text": {
          "type": "string",
          "description": "Complete transcript text (single_shot mode or final streamed)"
        },
        "utterances": {
          "type": "array",
          "description": "Array of individual utterances with speaker info",
          "items": {
            "type": "object",
            "required": ["speaker", "text", "timestamp"],
            "properties": {
              "speaker": {
                "type": "string",
                "enum": ["caller", "agent", "system"]
              },
              "text": {
                "type": "string"
              },
              "timestamp": {
                "type": "number",
                "description": "Offset in seconds from call start"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Speech recognition confidence score"
              },
              "is_final": {
                "type": "boolean",
                "description": "Whether this utterance is finalized (streamed mode)"
              }
            }
          }
        },
        "partial_text": {
          "type": "string",
          "description": "Current partial/interim transcript (streamed mode only)"
        },
        "sequence_number": {
          "type": "integer",
          "minimum": 0,
          "description": "Sequence number for ordering streamed updates"
        }
      }
    },
    "voice_platform": {
      "type": "object",
      "description": "Metadata about the voice platform",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Voice platform provider name (e.g., twilio, vapi, retell)"
        },
        "version": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional platform-specific metadata",
      "additionalProperties": true
    }
  }
}
